# Copia este fichero a .env y ajusta lo que necesites. Todo tiene un valor por
# defecto, así que .env sólo hace falta si algún puerto ya está ocupado o si
# quieres levantar más de una instancia a la vez.

# Puertos publicados en tu máquina.
WEB_PORT=5180
API_PORT=5181
DB_PORT=5433

# Credenciales de PostgreSQL. La base de datos no se expone fuera de localhost;
# aun así, cámbialas si vas a dejar la herramienta levantada en una red compartida.
DB_USER=agile
DB_PASSWORD=agile
DB_NAME=agile

# Nombre del proyecto de Compose. Cambiarlo levanta una instancia independiente,
# con su propio volumen de datos. Así funciona `make demo`.
COMPOSE_PROJECT_NAME=agile

# Nivel de log de la API: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
